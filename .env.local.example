# URL base de la API de Web Intelligence / Lead Intelligence.
# En desarrollo local apunta al backend FastAPI corriendo en tu máquina.
# En producción, cambiar por la URL pública donde se despliegue el backend
# (ej. https://api.agustinescuderoweb.com o la URL que te dé Vercel).
NEXT_PUBLIC_WEB_INTELLIGENCE_API_URL=http://127.0.0.1:8000

# La clave admin (X-Admin-Key) NO va acá. /admin/intelligence la pide por
# un input manual en el momento — nunca uses un prefijo NEXT_PUBLIC_ para
# una clave administrativa: cualquier variable NEXT_PUBLIC_* queda
# incrustada en el JS público que descarga el navegador.
